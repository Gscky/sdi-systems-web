# Variables del formulario de contacto (/api/contacto).
# Copiar a `.env` para desarrollo local y configurarlas en Vercel para produccion.
# `.env` esta en .gitignore: las claves NUNCA se commitean.

# Clave de la cuenta de Resend (resend.com/api-keys). Empieza con re_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Destinatarios de los leads. Varios separados por coma.
CONTACTO_TO=contacto@sdisystems.cl

# Remitente. El dominio debe estar verificado en Resend (registros SPF/DKIM).
CONTACTO_FROM=Web SDI Systems <web@sdisystems.cl>
