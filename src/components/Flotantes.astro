---
// Botones flotantes al costado (WhatsApp + LinkedIn). Pedido de Ariel, jul-2026.
//
// ⚠️ FALTA LA URL DE LINKEDIN. Pegar abajo la del perfil de empresa de SDI y el
// boton aparece solo. Mientras este vacia NO se renderiza: es a proposito —
// preferimos que falte el boton antes que publicar un enlace equivocado (hay
// varias empresas llamadas "SDI" en LinkedIn, incluida una estadounidense del
// mismo rubro).
const LINKEDIN = "";

const WHATSAPP = "56974961585";
const WHATSAPP_URL = `https://wa.me/${WHATSAPP}`;
---

<div class="flotantes" aria-label="Contacto directo">
  <a
    class="flotante flotante--wsp"
    href={WHATSAPP_URL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escríbenos por WhatsApp"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12.04 2a9.9 9.9 0 00-8.43 15.16L2 22l4.95-1.3A9.9 9.9 0 1012.04 2zm0 1.8a8.1 8.1 0 11-4.13 15.06l-.3-.18-2.94.77.78-2.86-.2-.31A8.1 8.1 0 0112.04 3.8zm4.64 9.9c-.25-.13-1.47-.72-1.7-.8-.23-.09-.4-.13-.56.13-.17.25-.64.8-.79.96-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.74 2.66 4.22 3.73.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.23-.17-.48-.3z"/>
    </svg>
    <span class="flotante__label">WhatsApp</span>
  </a>

  {
    LINKEDIN && (
      <a
        class="flotante flotante--in"
        href={LINKEDIN}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Síguenos en LinkedIn"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21h-4V9z"/>
        </svg>
        <span class="flotante__label">LinkedIn</span>
      </a>
    )
  }
</div>

<style>
  .flotantes {
    position: fixed;
    right: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    /* Bajo el navbar (1000) y bajo el modal de casos (2000): cuando se abre un
       video, el modal los tapa como corresponde. */
    z-index: 900;
  }

  .flotante {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: var(--white);
    box-shadow: var(--shadow);
    transition: transform var(--t), box-shadow var(--t);
  }

  .flotante svg {
    width: 24px;
    height: 24px;
  }

  .flotante--wsp {
    background: #25d366; /* verde oficial de WhatsApp */
  }

  .flotante--in {
    background: #0a66c2; /* azul oficial de LinkedIn */
  }

  .flotante:hover {
    transform: scale(1.07);
    box-shadow: var(--shadow-lg);
    color: var(--white);
  }

  .flotante:focus-visible {
    outline: 3px solid var(--brand-gold);
    outline-offset: 3px;
  }

  /* Etiqueta que asoma al pasar el mouse (solo donde hay puntero real) */
  .flotante__label {
    position: absolute;
    right: calc(100% + 0.6rem);
    white-space: nowrap;
    background: var(--brand-navy);
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    opacity: 0;
    pointer-events: none;
    transform: translateX(6px);
    transition: opacity var(--t), transform var(--t);
  }

  @media (hover: hover) and (pointer: fine) {
    .flotante:hover .flotante__label,
    .flotante:focus-visible .flotante__label {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* En celular no hay hover: la etiqueta nunca debe ocupar espacio ni leerse */
  @media (hover: none) {
    .flotante__label {
      display: none;
    }
  }

  /* Movil: se van abajo a la derecha para no tapar el texto a media pantalla */
  @media (max-width: 720px) {
    .flotantes {
      top: auto;
      bottom: 1rem;
      right: 0.75rem;
      transform: none;
      gap: 0.5rem;
    }

    .flotante {
      /* 44px es el minimo recomendado para tocar con el dedo */
      width: 44px;
      height: 44px;
    }

    .flotante svg {
      width: 22px;
      height: 22px;
    }
  }

  @media print {
    .flotantes {
      display: none;
    }
  }
</style>
