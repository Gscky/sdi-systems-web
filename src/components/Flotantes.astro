---
// Boton flotante de LinkedIn. Pedido de Ariel: quedar SOLO LinkedIn
// (se quito el de WhatsApp el 2-ago-2026). WhatsApp sigue disponible en la
// seccion Contacto y en el Footer.
//
// LinkedIn de la empresa, confirmado por Gabriel (31-jul-2026). Es el perfil
// chileno (`sdi-systems-cl`), no el de la homonima estadounidense del mismo
// rubro. Si queda vacio el boton no se renderiza, para no publicar un enlace
// equivocado.
const LINKEDIN = "https://www.linkedin.com/company/sdi-systems-cl/";
---

<div class="flotantes" aria-label="Contacto directo">
  {
    LINKEDIN && (
      <a
        class="flotante flotante--in"
        href={LINKEDIN}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Síguenos en LinkedIn"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21h-4V9z"/>
        </svg>
        <span class="flotante__label">LinkedIn</span>
      </a>
    )
  }
</div>

<style>
  /* Esquina inferior derecha (pedido de Gabriel, 31-jul). Antes iban centrados
     verticalmente al costado. */
  .flotantes {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    /* Bajo el navbar (1000) y bajo el modal de casos (2000): cuando se abre un
       video, el modal los tapa como corresponde. */
    z-index: 900;
  }

  .flotante {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: var(--white);
    box-shadow: var(--shadow);
    transition: transform var(--t), box-shadow var(--t);
  }

  .flotante svg {
    width: 24px;
    height: 24px;
  }

  .flotante--in {
    background: #0a66c2; /* azul oficial de LinkedIn */
  }

  .flotante:hover {
    transform: scale(1.07);
    box-shadow: var(--shadow-lg);
    color: var(--white);
  }

  .flotante:focus-visible {
    outline: 3px solid var(--brand-gold);
    outline-offset: 3px;
  }

  /* Etiqueta que asoma al pasar el mouse (solo donde hay puntero real) */
  .flotante__label {
    position: absolute;
    right: calc(100% + 0.6rem);
    white-space: nowrap;
    background: var(--brand-navy);
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    opacity: 0;
    pointer-events: none;
    transform: translateX(6px);
    transition: opacity var(--t), transform var(--t);
  }

  @media (hover: hover) and (pointer: fine) {
    .flotante:hover .flotante__label,
    .flotante:focus-visible .flotante__label {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* En celular no hay hover: la etiqueta nunca debe ocupar espacio ni leerse */
  @media (hover: none) {
    .flotante__label {
      display: none;
    }
  }

  /* Movil: mismo rincon, un poco mas pegados al borde */
  @media (max-width: 720px) {
    .flotantes {
      right: 0.9rem;
      bottom: 0.9rem;
      gap: 0.5rem;
    }

    .flotante {
      /* 44px es el minimo recomendado para tocar con el dedo */
      width: 44px;
      height: 44px;
    }

    .flotante svg {
      width: 22px;
      height: 22px;
    }
  }

  @media print {
    .flotantes {
      display: none;
    }
  }
</style>
